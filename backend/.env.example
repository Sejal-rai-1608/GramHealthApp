# Server Port
PORT=3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gramhealth"

# JWT Authentication Secret
JWT_SECRET="your-jwt-secret-key"

# Python AI Microservice Gateway URL
# Local Development:
GRAM_AI_URL="http://127.0.0.1:8001"
# Production (Render):
# GRAM_AI_URL="https://<python-ai-render-service>.onrender.com"

# Shared secret required by the Python AI service in production.
# Configure the same random value on the Node and Python Render services.
GRAM_AI_INTERNAL_TOKEN="replace-with-a-long-random-token"

# Environment (development | production)
NODE_ENV="development"
